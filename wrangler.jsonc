{
  // Cloudflare Workers static assets, assets-only: NO Worker script. Every request
  // is answered by static assets (free, never billed against the Workers request quota).
  // Docs: https://developers.cloudflare.com/workers/static-assets/
  "name": "tugql-org",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    // Unknown URLs serve the nearest 404.html (public/404.html) with HTTP 404.
    "not_found_handling": "404-page",
    // Redirect /index.html and trailing-slash variants to clean URLs.
    "html_handling": "auto-trailing-slash"
  },
  // All four hosts stay attached as Custom Domains (Cloudflare keeps their proxied DNS).
  // Host 301s are NOT done in this Worker. run_worker_first patterns are paths, not
  // hostnames, and run_worker_first: true would bill every request. A public/_redirects
  // rule is also path-based, so it would redirect tugql.org itself. Alexander adds
  // zone Redirect Rules (HTTP 301, preserve query string) before this deployment:
  //   zone tugql.org: http*://www.tugql.org/* -> https://tugql.org/${2}
  //   zone dtql.org:  http*://dtql.org/* and http*://www.dtql.org/* -> https://tugql.org/${2}
  // Exact dashboard steps are in DEPLOY.md.
  "routes": [
    { "pattern": "tugql.org", "custom_domain": true },
    { "pattern": "www.tugql.org", "custom_domain": true },
    { "pattern": "dtql.org", "custom_domain": true },
    { "pattern": "www.dtql.org", "custom_domain": true }
  ]
}
